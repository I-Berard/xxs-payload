javascript:(async()=>{
const panel=document.createElement('div');
panel.id='sf-panel';
panel.style='position:fixed;bottom:0;left:0;width:55%;height:65vh;overflow:auto;background:#0d1117;color:#c9d1d9;padding:12px;z-index:2147483647;font-size:11px;font-family:monospace;border-top:2px solid #30363d;border-right:2px solid #30363d;box-shadow:0 -4px 24px rgba(0,0,0,.7)';
document.body.appendChild(panel);

const log=(msg,cls='')=>{ const d=document.createElement('div'); d.innerHTML=msg; if(cls) d.style.cssText=cls; panel.appendChild(d); panel.scrollTop=panel.scrollHeight; };
const c=(t,col)=>`<span style="color:${col}">${t}</span>`;

// ---------------- CONFIG ----------------
const isJS=url=>/\.js(\?|$)/i.test(url);
const normalize=url=>{ try{return new URL(url,location.href).href;}catch{return null;} };

// ---------------- EXTENSIVE REGEX DB ----------------
const regexDB={

  /* ── Google ─────────────────────────────────────────── */
  google_api:          /AIza[0-9A-Za-z\-_]{35}/g,
  firebase_server_key: /AAAA[A-Za-z0-9_-]{7}:[A-Za-z0-9_-]{140}/g,
  google_captcha:      /6L[0-9A-Za-z\-_]{38}/g,
  google_oauth:        /ya29\.[0-9A-Za-z\-_]+/g,
  google_cloud_key:    /AIza[0-9A-Za-z\-_]{35}/g,

  /* ── AWS ─────────────────────────────────────────────── */
  aws_access_key_std:  /(?:A(?:KIA|SIA|ROA|BIA|CCA)[0-9A-Z]{16})/g,
  aws_mws_auth_token:  /amzn\.mws\.[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/g,
  aws_secret_key:      /(?:aws.{0,20})?['"][0-9a-zA-Z\/+]{40}['"]/gi,
  aws_s3_url:          /([a-zA-Z0-9\.\-_]+\.s3\.amazonaws\.com|s3:\/\/[a-zA-Z0-9\.\-_]+|s3-[a-zA-Z0-9\.\-_\/]+|s3\.amazonaws\.com\/[a-zA-Z0-9\.\-_]+|s3\.console\.aws\.amazon\.com\/s3\/buckets\/[a-zA-Z0-9\.\-_]+)/g,

  /* ── Azure ───────────────────────────────────────────── */
  azure_storage_account: /DefaultEndpointsProtocol=https?;AccountName=[^;]+;AccountKey=[A-Za-z0-9+\/=]{88}/g,
  azure_sas_token:       /sv=[0-9]{4}-[0-9]{2}-[0-9]{2}&s[a-z]=.{10,200}/g,
  azure_client_secret:   /[A-Za-z0-9~._-]{34}~[A-Za-z0-9~._-]{8}/g,

  /* ── GitHub ──────────────────────────────────────────── */
  github_token_classic:  /ghp_[A-Za-z0-9]{36}/g,
  github_token_oauth:    /gho_[A-Za-z0-9]{36}/g,
  github_token_app:      /ghs_[A-Za-z0-9]{36}/g,
  github_token_refresh:  /ghr_[A-Za-z0-9]{76}/g,
  github_access_url:     /[a-zA-Z0-9_-]+:[a-zA-Z0-9_\-]+@github\.com/g,
  github_pat:            /github_pat_[A-Za-z0-9_]{82}/g,

  /* ── GitLab ──────────────────────────────────────────── */
  gitlab_pat:            /glpat-[A-Za-z0-9\-_]{20}/g,
  gitlab_runner_token:   /glrt-[A-Za-z0-9\-_]{20}/g,

  /* ── Stripe ──────────────────────────────────────────── */
  stripe_live_key:       /sk_live_[0-9a-zA-Z]{24}/g,
  stripe_test_key:       /sk_test_[0-9a-zA-Z]{24}/g,
  stripe_restricted_key: /rk_live_[0-9a-zA-Z]{24}/g,
  stripe_publishable:    /pk_live_[0-9a-zA-Z]{24}/g,
  stripe_webhook_secret: /whsec_[a-zA-Z0-9]{32,}/g,

  /* ── Slack ───────────────────────────────────────────── */
  slack_token_xoxb:      /xoxb-[0-9]{11}-[0-9]{11}-[0-9a-zA-Z]{24}/g,
  slack_token_xoxp:      /xoxp-[0-9]+-[0-9]+-[0-9]+-[a-f0-9]+/g,
  slack_token_xoxa:      /xoxa-[0-9]+-[0-9]+-[0-9]+-[a-f0-9]+/g,
  slack_token_generic:   /xox[baprs]-[0-9a-zA-Z\-]{10,}/g,
  slack_webhook:         /https:\/\/hooks\.slack\.com\/services\/T[0-9A-Z]+\/B[0-9A-Z]+\/[0-9a-zA-Z]+/g,

  /* ── Twilio ──────────────────────────────────────────── */
  twilio_api_key:        /SK[0-9a-fA-F]{32}/g,
  twilio_account_sid:    /AC[a-zA-Z0-9_\-]{32}/g,
  twilio_app_sid:        /AP[a-zA-Z0-9_\-]{32}/g,
  twilio_auth_token:     /(?<=twilio.{0,30})[0-9a-f]{32}|[0-9a-f]{32}(?=.{0,30}twilio)/gi,

  /* ── Facebook / Meta ─────────────────────────────────── */
  facebook_access_token: /EAACEdEose0cBA[0-9A-Za-z]+/g,
  facebook_oauth:        /[fF][aA][cC][eE][bB][oO][oO][kK].*['"][0-9a-f]{32}['"]/g,

  /* ── Mailgun ─────────────────────────────────────────── */
  mailgun_api_key:       /key-[0-9a-zA-Z]{32}/g,
  mailgun_pub_key:       /pubkey-[0-9a-zA-Z]{32}/g,

  /* ── Mailchimp ───────────────────────────────────────── */
  mailchimp_api_key:     /[0-9a-f]{32}-us[0-9]{1,2}/g,

  /* ── SendGrid ────────────────────────────────────────── */
  sendgrid_api_key:      /SG\.[a-zA-Z0-9\-_]{22}\.[a-zA-Z0-9\-_]{43}/g,

  /* ── PayPal / Braintree ──────────────────────────────── */
  paypal_braintree:      /access_token\$production\$[0-9a-z]{16}\$[0-9a-f]{32}/g,
  braintree_api_key:     /(?:braintree|bt_[a-z]+_)[0-9a-z]{32}/gi,

  /* ── Square ──────────────────────────────────────────── */
  square_oauth_secret:   /sq0csp-[0-9A-Za-z\-_]{43}/g,
  square_access_token:   /sqOatp-[0-9A-Za-z\-_]{22}|EAAA[a-zA-Z0-9]{60}/g,
  square_app_secret:     /sq0[a-z]{3}-[0-9A-Za-z\-_]{22,43}/g,

  /* ── Shopify ─────────────────────────────────────────── */
  shopify_access_token:  /shpat_[a-fA-F0-9]{32}/g,
  shopify_shared_secret: /shpss_[a-fA-F0-9]{32}/g,
  shopify_custom_app:    /shpca_[a-fA-F0-9]{32}/g,
  shopify_partner:       /shppa_[a-fA-F0-9]{32}/g,

  /* ── Twitch ──────────────────────────────────────────── */
  twitch_oauth:          /oauth:[a-z0-9]{30}/gi,
  twitch_client_id:      /(?:twitch.{0,20})[a-z0-9]{30}/gi,

  /* ── Discord ─────────────────────────────────────────── */
  discord_bot_token:     /[MN][A-Za-z\d]{23}\.[\w-]{6}\.[\w-]{27}/g,
  discord_webhook:       /https:\/\/discord(?:app)?\.com\/api\/webhooks\/[0-9]+\/[A-Za-z0-9\-_]+/g,
  discord_nitro:         /[a-zA-Z0-9]{24}\.[a-zA-Z0-9_\-]{6}\.[a-zA-Z0-9_\-]{27}/g,

  /* ── Telegram ────────────────────────────────────────── */
  telegram_bot_token:    /[0-9]{8,10}:[a-zA-Z0-9_-]{35}/g,

  /* ── npm / PyPI ──────────────────────────────────────── */
  npm_token:             /npm_[A-Za-z0-9]{36}/g,
  pypi_token:            /pypi-[A-Za-z0-9_\-]{64,}/g,

  /* ── Heroku ──────────────────────────────────────────── */
  heroku_api_key:        /[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/g,

  /* ── Netlify ─────────────────────────────────────────── */
  netlify_token:         /netlify_[A-Za-z0-9_\-]{36}/g,

  /* ── Vercel ──────────────────────────────────────────── */
  vercel_token:          /(?:vercel.{0,10})[A-Za-z0-9]{24}|VERCEL_TOKEN[\s=:"']+[A-Za-z0-9]{24}/gi,

  /* ── Cloudflare ──────────────────────────────────────── */
  cloudflare_api_key:    /(?:cloudflare.{0,20})[0-9a-f]{37}/gi,
  cloudflare_api_token:  /(?:cloudflare.{0,20}|CF_API_TOKEN[\s=:"']+)[A-Za-z0-9_\-]{40}/gi,

  /* ── Databricks ──────────────────────────────────────── */
  databricks_token:      /dapi[a-h0-9]{32}/g,

  /* ── Hugging Face ────────────────────────────────────── */
  hf_token:              /hf_[A-Za-z]{34}/g,

  /* ── OpenAI ──────────────────────────────────────────── */
  openai_api_key:        /sk-[A-Za-z0-9]{48}/g,
  openai_org:            /org-[A-Za-z0-9]{24}/g,

  /* ── Anthropic ───────────────────────────────────────── */
  anthropic_api_key:     /sk-ant-api[0-9]+-[A-Za-z0-9_\-]{93}/g,

  /* ── JWT ─────────────────────────────────────────────── */
  jwt:                   /ey[A-Za-z0-9\-_]{10,}\.[A-Za-z0-9\-_]{10,}\.[A-Za-z0-9\-_+\/=]{10,}/g,

  /* ── Auth headers ────────────────────────────────────── */
  authorization_bearer:  /bearer\s+[a-zA-Z0-9_\-\.=:+\/]{10,200}/gi,
  authorization_basic:   /basic\s+[a-zA-Z0-9=:_+\/-]{5,100}/gi,
  authorization_api_key: /api[_\-]?key[\s]*[=:'"]+\s*[a-zA-Z0-9_\-]{10,}/gi,
  x_api_key_header:      /['"]?[Xx]-[Aa][Pp][Ii]-[Kk][Ee][Yy]['"]?\s*[:=]\s*['"]?[A-Za-z0-9_\-]{10,}['"]?/g,

  /* ── Private Keys ────────────────────────────────────── */
  rsa_private_key:       /-----BEGIN RSA PRIVATE KEY-----/g,
  dsa_private_key:       /-----BEGIN DSA PRIVATE KEY-----/g,
  ec_private_key:        /-----BEGIN EC PRIVATE KEY-----/g,
  pgp_private_block:     /-----BEGIN PGP PRIVATE KEY BLOCK-----/g,
  openssh_private_key:   /-----BEGIN OPENSSH PRIVATE KEY-----/g,
  pkcs8_private_key:     /-----BEGIN PRIVATE KEY-----/g,
  ssh_rsa_key:           /ssh-rsa\s+AAAA[0-9A-Za-z+\/]+[=]{0,3}/g,

  /* ── Generic Credentials ─────────────────────────────── */
  possible_password:     /(?:password|passwd|pwd)\s*[:=]\s*['"][^'"\s]{8,}['"]/gi,
  possible_secret:       /(?:secret|api_secret|client_secret)\s*[:=]\s*['"][^'"\s]{8,}['"]/gi,
  possible_token:        /(?:access_token|auth_token|refresh_token)\s*[:=]\s*['"][^'"\s]{20,}['"]/gi,
  possible_api_key:      /(?:apikey|api_key|appkey|app_key)\s*[:=]\s*['"][a-zA-Z0-9_\-]{16,}['"]/gi,
  db_connection_string:  /(?:mongodb(?:\+srv)?|postgresql|mysql|redis|amqp):\/\/[^'";\s]{10,}/gi,

  /* ── Sensitive URL patterns ──────────────────────────── */
  basic_auth_url:        /https?:\/\/[a-zA-Z0-9_\-]+:[^@\s]{3,}@[a-zA-Z0-9_\-\.]+/g,

};

// ---------------- ENTROPY + DENYLIST FILTER ----------------
const DENYLIST=/^(0+|f+|a+b+c+d*|abcdef|example|placeholder|test|dummy|changeme|password|secret|token|your[-_]?api[-_]?key|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff|deadbeef|cafebabe)$/i;
const SEQUENTIAL=/^[a-z]{20,}$|^[A-Z]{20,}$|^[0-9]{15,}$/;

const entropy=s=>{
  const f={};
  for(const ch of s)f[ch]=(f[ch]||0)+1;
  const n=s.length;
  return -Object.values(f).reduce((a,v)=>{const p=v/n;return a+p*Math.log2(p);},0);
};

// Types where we enforce minimum entropy on the matched token
const ENTROPY_CHECK=new Set(['heroku_api_key','twilio_auth_token','aws_secret_key','mailchimp_api_key','braintree_api_key','cloudflare_api_key']);

const isJunk=(key,val)=>{
  const stripped=val.replace(/[^a-zA-Z0-9]/g,'');
  if(DENYLIST.test(stripped)||DENYLIST.test(val))return true;
  if(SEQUENTIAL.test(val))return true;
  if(ENTROPY_CHECK.has(key)&&entropy(stripped)<3.2)return true;
  // drop CSS custom properties and obvious JS identifiers
  if(/^--[a-z]/.test(val)||/[A-Z]{2}[a-z]{2}[A-Z]/.test(val))return false; // let it through
  return false;
};

// ---------------- SECRET SCANNER ----------------
const extractSecrets=(text)=>{
  const results={};
  for(const [key,rx] of Object.entries(regexDB)){
    rx.lastIndex=0;
    let m;
    while((m=rx.exec(text))!==null){
      const val=m[0];
      if(isJunk(key,val))continue;
      if(!results[key]) results[key]=new Set();
      results[key].add(val);
    }
  }
  return results;
};

// ---------------- JS LINK EXTRACTION ----------------
const extractJS=content=>[...content.matchAll(/['"]((?:https?:\/\/|\/)[^'"]+\.js[^'"]*)['"]/gi)]
  .map(m=>normalize(m[1])).filter(Boolean).filter(isJS);

// ---------------- FETCH ----------------
const fetchText=async url=>{
  try{ const r=await fetch(url,{credentials:'omit'}); return r.ok?await r.text():null; }catch{return null;}
};

// ---------------- SEVERITY ----------------
const HIGH=/google_api|firebase|aws_access|stripe_live|openai|anthropic|heroku|github_token|shopify|sendgrid|discord_bot|telegram_bot|rsa_private|dsa_private|ec_private|pgp_private|openssh_private|pkcs8|databricks|hf_token/;
const MED=/jwt|bearer|paypal|braintree|square|twilio|mailgun|mailchimp|npm_token|pypi_token|netlify|cloudflare|gitlab/;
const sevColor=k=>HIGH.test(k)?'#ff4d4f':MED.test(k)?'#faad14':'#52c41a';
const sevLabel=k=>HIGH.test(k)?'HIGH':MED.test(k)?'MED':'LOW';

// ──────────── PANEL HEADER ────────────────────────────
log(`<span style="color:#58a6ff;font-size:13px;font-weight:bold">🔍 Secrets Finder</span> <span style="color:#8b949e">v2.0</span>`);
log(`<span style="color:#8b949e">Target: ${c(location.hostname,'#79c0ff')} | ${new Date().toISOString()}</span>`);
log('<hr style="border-color:#30363d;margin:4px 0">');

// ---------------- BFS CRAWLER ----------------
const visited=new Set();
const queue=[];
const globalSecrets={};

// seed from performance entries
performance.getEntriesByType('resource')
  .filter(e=>isJS(e.name))
  .forEach(e=>{ const n=normalize(e.name); if(n)queue.push(n); });

// also scan inline scripts
document.querySelectorAll('script:not([src])').forEach(s=>{
  const found=extractSecrets(s.textContent||'');
  for(const[t,set]of Object.entries(found)){
    if(!globalSecrets[t])globalSecrets[t]=new Set();
    set.forEach(v=>globalSecrets[t].add(v));
  }
});

while(queue.length){
  const url=queue.shift();
  if(visited.has(url))continue;
  visited.add(url);

  log(`${c('[→]','#3fb950')} <span style="color:#8b949e">${url}</span>`);

  const content=await fetchText(url);
  if(!content)continue;

  const found=extractSecrets(content);

  for(const[type,set]of Object.entries(found)){
    if(!globalSecrets[type])globalSecrets[type]=new Set();
    set.forEach(v=>globalSecrets[type].add(v));
  }

  const moreJS=extractJS(content);
  for(const f of moreJS){ if(!visited.has(f))queue.push(f); }
}

// ---------------- OUTPUT ----------------
log('<hr style="border-color:#30363d;margin:4px 0">');
log(`${c('FILES SCANNED','#8b949e')}: ${c(visited.size,'#58a6ff')}  ${c('JS + INLINE','#8b949e')}`);

let total=0;
const byCategory={};
for(const[type,set]of Object.entries(globalSecrets)){
  total+=set.size;
  byCategory[type]=set;
}

log(`${c('TOTAL SECRETS','#8b949e')}: ${c(total,total>0?'#ff4d4f':'#3fb950')}`);
log('<hr style="border-color:#30363d;margin:4px 0">');

// sort by severity then name
const sorted=Object.entries(byCategory).sort(([a],[b])=>{
  const score=k=>HIGH.test(k)?0:MED.test(k)?1:2;
  return score(a)-score(b)||a.localeCompare(b);
});

for(const[type,set]of sorted){
  const col=sevColor(type);
  const lbl=sevLabel(type);
  log(`<br>${c('▶','#8b949e')} ${c(type,'#e3b341')} ${c('['+lbl+']',col)} ${c('('+set.size+')','#8b949e')}`);
  set.forEach(v=>{
    const disp=v.length>120?v.slice(0,120)+'…':v;
    log(`  ${c('↳','#30363d')} <span style="color:#ffa657;word-break:break-all">${disp}</span>`);
  });
}

// ---------------- TOOLBAR ────────────────────────────
const bar=document.createElement('div');
bar.style='position:sticky;bottom:0;background:#161b22;padding:6px;border-top:1px solid #30363d;display:flex;gap:6px;align-items:center';

const mkBtn=(label,fn,bg='#21262d')=>{
  const b=document.createElement('button');
  b.textContent=label;
  b.style=`background:${bg};color:#c9d1d9;border:1px solid #30363d;border-radius:4px;padding:3px 10px;cursor:pointer;font-size:11px;font-family:monospace`;
  b.onmouseenter=()=>b.style.background='#30363d';
  b.onmouseleave=()=>b.style.background=bg;
  b.onclick=fn;
  return b;
};

bar.appendChild(mkBtn('⬇ Download TXT',()=>{
  let out=`Secrets Finder v2.0 – ${location.href}\nDate: ${new Date().toISOString()}\n\n`;
  out+=`FILES SCANNED (${visited.size}):\n`+[...visited].join('\n')+'\n\n';
  out+=`SECRETS (${total}):\n`;
  for(const[type,set]of sorted){
    out+=`\n[${type}] [${sevLabel(type)}] (${set.size}):\n`;
    set.forEach(v=>{ out+='  '+v+'\n'; });
  }
  const a=Object.assign(document.createElement('a'),{
    href:URL.createObjectURL(new Blob([out],{type:'text/plain'})),
    download:'secrets_'+location.hostname+'_'+Date.now()+'.txt'
  });
  a.click();
},'#238636'));

bar.appendChild(mkBtn('⬇ Download JSON',()=>{
  const obj={meta:{target:location.href,date:new Date().toISOString(),files:visited.size,total_secrets:total},files:[...visited],secrets:{}};
  for(const[type,set]of sorted) obj.secrets[type]={severity:sevLabel(type),count:set.size,matches:[...set]};
  const a=Object.assign(document.createElement('a'),{
    href:URL.createObjectURL(new Blob([JSON.stringify(obj,null,2)],{type:'application/json'})),
    download:'secrets_'+location.hostname+'_'+Date.now()+'.json'
  });
  a.click();
},'#1f6feb'));

bar.appendChild(mkBtn('✕ Close',()=>panel.remove(),'#6e2c2c'));

panel.appendChild(bar);
})();
