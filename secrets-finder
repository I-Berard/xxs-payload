javascript:(async()=>{
const panel=document.createElement('div');
panel.style='position:fixed;bottom:0;left:0;width:50%;height:60vh;overflow:auto;background:#000;color:#0f0;padding:10px;z-index:999999;font-size:11px;font-family:monospace';
document.body.appendChild(panel);

const log=(msg)=>panel.innerHTML+=msg+"<br>";

// ---------------- CONFIG ----------------
const isJS = url => /\.js(\?|$)/i.test(url);

const normalize = (url)=>{
  try{return new URL(url,location.href).href;}catch{return null;}
};

// ---------------- EXTENSIVE REGEX ----------------
const regexDB = {
  google_api: /AIza[0-9A-Za-z-_]{35}/g,
  firebase: /AAAA[A-Za-z0-9_-]{7}:[A-Za-z0-9_-]{140}/g,
  google_oauth: /ya29\.[0-9A-Za-z\-_]+/g,

  aws_access: /A[SK]IA[0-9A-Z]{16}/g,
  aws_s3_url: /([a-zA-Z0-9\.\-_]+\.s3\.amazonaws\.com|s3:\/\/[a-zA-Z0-9\.\-_]+)/g,

  stripe_key: /sk_live_[0-9a-zA-Z]{24}/g,
  stripe_restricted: /rk_live_[0-9a-zA-Z]{24}/g,

  github_token: /[a-zA-Z0-9_-]+:[a-zA-Z0-9_\-]+@github\.com/g,

  slack_token: /xox[baprs]-[0-9a-zA-Z\-]+/g,

  private_key: /-----BEGIN [A-Z ]+ PRIVATE KEY-----/g,

  jwt: /ey[A-Za-z0-9-_]+\.[A-Za-z0-9-_]+\.[A-Za-z0-9-_]+/g,

  bearer: /bearer\s+[a-zA-Z0-9_\-\.=:_\+\/]{10,}/gi,
  basic_auth: /basic\s+[a-zA-Z0-9=:_\+\/-]{10,}/gi,

  mailgun: /key-[0-9a-zA-Z]{32}/g,
  twilio_key: /SK[0-9a-fA-F]{32}/g,

  paypal: /access_token\$production\$[0-9a-z]{16}\$[0-9a-f]{32}/g,

  square: /sq0[a-z]{3}-[0-9A-Za-z\-_]{20,}/g,

  creds: /(?i)(password\s*[=:"]+\s*[^\s]+|passwd\s*[=:"]+\s*[^\s]+)/g
};

// ---------------- SECRET SCANNER ----------------
const extractSecrets = (text)=>{
  const results = {};

  for(const [key,regex] of Object.entries(regexDB)){
    let match;
    while((match = regex.exec(text)) !== null){
      if(!results[key]) results[key]=new Set();
      results[key].add(match[0]);
    }
  }

  return results;
};

// ---------------- JS LINK EXTRACTION ----------------
const extractJS = content => {
  return [...content.matchAll(/['"]([^'"]+\.js[^'"]*)['"]/gi)]
    .map(m=>normalize(m[1]))
    .filter(Boolean)
    .filter(isJS);
};

// ---------------- FETCH ----------------
const fetchText = async(url)=>{
  try{
    const res = await fetch(url);
    return res.ok ? await res.text() : null;
  }catch{return null;}
};

// ---------------- BFS CRAWLER ----------------
const visited=new Set();
const queue=[];

performance.getEntriesByType("resource")
  .map(e=>e.name)
  .filter(isJS)
  .forEach(u=>{
    const n=normalize(u);
    if(n) queue.push(n);
  });

const globalSecrets = {};

while(queue.length){
  const url=queue.shift();

  if(visited.has(url)) continue;
  visited.add(url);

  log(`[+] ${url}`);

  const content=await fetchText(url);
  if(!content) continue;

  // ---- scan secrets ----
  const found = extractSecrets(content);

  for(const [type,set] of Object.entries(found)){
    if(!globalSecrets[type]) globalSecrets[type]=new Set();
    set.forEach(v=>globalSecrets[type].add(v));
  }

  // ---- find more JS ----
  const foundJS = extractJS(content);
  for(const f of foundJS){
    if(!visited.has(f)) queue.push(f);
  }
}

// ---------------- OUTPUT ----------------
log("<hr>");
log(`<b>Total JS Files:</b> ${visited.size}`);

let totalSecrets = 0;
for(const v of Object.values(globalSecrets)) totalSecrets += v.size;

log(`<b>Total Secrets:</b> ${totalSecrets}<br>`);

// categorized output
for(const [type,set] of Object.entries(globalSecrets)){
  log(`<br><b>[${type}] (${set.size})</b>`);
  set.forEach(v=>log(v));
}

// ---------------- DOWNLOAD ----------------
const btn=document.createElement('button');
btn.textContent='Download Results';
btn.onclick=()=>{
  let out="JS FILES:\n"+[...visited].join("\n")+"\n\nSECRETS:\n";
  for(const [type,set] of Object.entries(globalSecrets)){
    out+=`\n[${type}]\n`+[...set].join("\n")+"\n";
  }

  const blob=new Blob([out],{type:'text/plain'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='recon_results.txt';
  a.click();
};
panel.appendChild(document.createElement('br'));
panel.appendChild(btn);

})();
